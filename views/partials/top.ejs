<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title><%= title %> — Mobilpymes</title>
  <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
  <link rel="stylesheet" href="/static/css/base24.css">
</head>
<body>
<div class="eclipse-window">

  <!-- Title Bar -->
  <div class="eclipse-titlebar">
    <span class="eclipse-logo">Mobilpymes</span>
    <span class="title-text"><%= title || 'Dashboard' %> - Eclipse IDE</span>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <span style="font-size:11px; color:#aaa; margin-right:12px;">
        &#128100; <%= currentUser.username %>
        <span style="font-size:10px; opacity:.7;">(<%= currentUser.role %>)</span>
      </span>
    <% } %>
    <span class="winbtn">&#8211;</span>
    <span class="winbtn">&#9633;</span>
    <span class="winbtn close">&#10005;</span>
  </div>

  <!-- Menu Bar -->
  <div class="eclipse-menubar">
    <% const links = {
         'File': '/', 'Configure': '/institution', 'System Operations': '/simulator',
         'Customer Management': '/cards', 'Edit': '#', 'View': '#', 'Window': '#', 'Help': '#'
       }; %>
    <% menus.forEach(function(m){ %>
      <a class="mi" href="<%= links[m] || '#' %>"><%- m.replace(/^(.)/, '<u>$1</u>') %></a>
    <% }); %>
    <span style="flex:1"></span>
    <a class="mi" href="/profile" title="Mi perfil">&#128100; Perfil</a>
    <a class="mi" href="/logout" title="Cerrar sesión">&#128275; Salir</a>
  </div>

  <!-- Toolbar -->
  <div class="eclipse-toolbar">
    <a class="tb" href="/institution" title="Institution">&#127974;</a>
    <a class="tb" href="/host"        title="Host / Interchange">&#128423;</a>
    <a class="tb" href="/prefix"      title="Prefix">&#128290;</a>
    <a class="tb" href="/routing"     title="Routing">&#128256;</a>
    <a class="tb" href="/limit"       title="Limit Profiles">&#9878;</a>
    <span class="sep"></span>
    <a class="tb" href="/cards"       title="Card Management">&#128179;</a>
    <span class="sep"></span>
    <a class="tb" href="/simulator"   title="Transaction Simulator">&#9654;</a>
    <span class="sep"></span>
    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
      <a class="tb" href="/users"     title="User Management">&#128101;</a>
      <span class="sep"></span>
    <% } %>
    <a class="tb" href="/"            title="Dashboard">&#127968;</a>
    <span class="tb-spacer"></span>
    <div class="persp-bar">
      <span class="persp active" title="BASE24-eps Perspective">&#128299;</span>
      <span class="persp"        title="Debug Perspective">&#128027;</span>
      <span class="persp"        title="Database Perspective">&#128452;</span>
    </div>
  </div>

  <!-- Workbench -->
  <div class="eclipse-workbench">

    <!-- Package Explorer -->
    <div class="eclipse-sidebar">
      <div class="view-header">
        <span class="view-title">Package Explorer</span>
        <span class="view-btn" title="Collapse All">&#8613;</span>
        <span class="view-btn" title="Menu">&#8942;</span>
      </div>
      <div class="view-content">
        <div class="tree-project">&#128193; Mobilpymes</div>

        <div class="tree-group">&#128274; Configuration</div>
        <a class="tree-item<%= active === 'Institution'       ? ' active' : '' %>" href="/institution">
          <span class="ico">&#127974;</span> Institution
        </a>
        <a class="tree-item<%= active === 'Host/Interchange'  ? ' active' : '' %>" href="/host">
          <span class="ico">&#128423;</span> Host / Interchange
        </a>
        <a class="tree-item<%= active === 'Prefix'            ? ' active' : '' %>" href="/prefix">
          <span class="ico">&#128290;</span> Prefix
        </a>
        <a class="tree-item<%= active === 'Routing'           ? ' active' : '' %>" href="/routing">
          <span class="ico">&#128256;</span> Routing
        </a>
        <a class="tree-item<%= active === 'Limit Profiles'    ? ' active' : '' %>" href="/limit">
          <span class="ico">&#9878;</span> Limit Profiles
        </a>

        <div class="tree-group">&#128101; Customer</div>
        <a class="tree-item<%= active === 'Cards'             ? ' active' : '' %>" href="/cards">
          <span class="ico">&#128179;</span> Card Management
        </a>

        <div class="tree-group">&#9654; Operations</div>
        <a class="tree-item<%= active === 'System Operations' ? ' active' : '' %>" href="/simulator">
          <span class="ico">&#9654;</span> Transaction Simulator
        </a>

        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
          <div class="tree-group">&#128272; Administration</div>
          <a class="tree-item<%= active === 'Users' ? ' active' : '' %>" href="/users">
            <span class="ico">&#128101;</span> User Management
          </a>
        <% } %>

        <div style="border-top:1px solid #E0E0E0; margin:4px 0;"></div>
        <a class="tree-item<%= active === 'Profile' ? ' active' : '' %>" href="/profile">
          <span class="ico">&#128100;</span> My Profile
        </a>
        <a class="tree-item" href="/logout">
          <span class="ico">&#128275;</span> Logout
        </a>
      </div>
    </div>

    <!-- Editor Area -->
    <div class="eclipse-editor-area">
      <div class="editor-tabstrip">
        <div class="editor-tab active">
          <span>&#128203;</span>
          <%= title || 'Dashboard' %>
          <span class="tab-close">&#10005;</span>
        </div>
      </div>
      <div class="editor-content">
