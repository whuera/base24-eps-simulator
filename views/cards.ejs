<%- include('partials/top') %>
<% const s = sel || {}; %>
<% const STATUS_BADGE = { Active:'ok', Blocked:'no', Lost:'warn', Stolen:'no', Expired:'warn' }; %>
<div class="mdi-window" style="max-width:820px">
  <div class="mdi-title"><span class="ico">💳</span> Card Configuration<%= s.pan ? ' — ' + s.pan.slice(0,6)+'****'+s.pan.slice(-4) : '' %>
    <span class="spacer"></span>
    <span class="mini-win">_</span><span class="mini-win">▢</span><span class="mini-win close">✕</span>
  </div>
  <div class="mdi-toolbar">
    <a class="tb" href="/cards" title="New">🗋</a>
    <span class="tb" title="Save" onclick="document.forms.cardForm.submit()">💾</span>
    <% if (s.pan) { %>
    <form method="post" action="/cards/delete" style="display:inline"
          onsubmit="return confirm('Delete card?')">
      <input type="hidden" name="pan" value="<%= s.pan %>">
      <button class="tb" style="border:none;background:none" title="Delete">🗑</button>
    </form>
    <% if (s.status === 'Blocked') { %>
    <form method="post" action="/cards/unblock" style="display:inline">
      <input type="hidden" name="pan" value="<%= s.pan %>">
      <button class="tb" style="border:none;background:none" title="Unblock Card">🔓</button>
    </form>
    <% } %>
    <% } %>
  </div>

  <% if (msg) { %><div class="alert alert-ok">&#10003; <%= msg %></div><% } %>
  <% if (error) { %><div class="alert alert-err">&#10005; <%= error %></div><% } %>

  <!-- Search / selector -->
  <div class="mdi-body" style="padding-bottom:6px; border-bottom:1px solid #E0E0E0">
    <div style="display:flex; gap:8px; align-items:center">
      <label style="font-size:11px; min-width:30px">Card</label>
      <select class="long" onchange="location.href='/cards?pan='+this.value">
        <option value="">— open card —</option>
        <% list.forEach(function(c){ %>
          <option value="<%= c.pan %>" <%= s.pan===c.pan?'selected':'' %>>
            <%= c.pan.slice(0,6)+'****'+c.pan.slice(-4) %>  <%= c.cardholder_name||'' %>
            (<%= c.status %>)
          </option>
        <% }); %>
      </select>
      <a class="btn" href="/cards">New Card</a>
    </div>
  </div>

  <form method="post" action="/cards" name="cardForm">
  <div class="mdi-body">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px">
      <!-- Left: Card info -->
      <div>
        <div class="form-row req">
          <label>PAN (Card Number)</label>
          <input class="long" type="text" name="pan" value="<%= s.pan||'' %>"
                 placeholder="16-digit card number" <%= s.pan?'readonly':'' %>>
        </div>
        <div class="form-row">
          <label>Cardholder Name</label>
          <input class="long" type="text" name="cardholder_name" value="<%= s.cardholder_name||'' %>">
        </div>
        <div class="form-row">
          <label>Expiry Date (MMYY)</label>
          <input class="short" type="text" name="expiry_date" value="<%= s.expiry_date||'' %>" placeholder="1228" maxlength="4">
        </div>
        <div class="form-row">
          <label>Card Type</label>
          <select class="med" name="card_type">
            <% ['Debit','Credit','Prepaid','Gift'].forEach(function(t){ %>
              <option <%= (s.card_type||'Debit')===t?'selected':'' %>><%= t %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <!-- Right: Issuer & status -->
      <div>
        <div class="form-row req">
          <label>Issuer ID</label>
          <select class="long" name="issuer_id">
            <option value="">— Select Issuer —</option>
            <% issuers.forEach(function(i){ %>
              <option value="<%= i.institution_id %>" <%= s.issuer_id===i.institution_id?'selected':'' %>>
                <%= i.institution_id %> — <%= i.institution_name %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="form-row">
          <label>Limit Profile</label>
          <select class="med" name="limit_profile">
            <% limits.forEach(function(l){ %>
              <option <%= (s.limit_profile||'LMT_STD')===l?'selected':'' %>><%= l %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-row">
          <label>Card Status</label>
          <select class="med" name="status">
            <% ['Active','Blocked','Lost','Stolen','Expired'].forEach(function(st){ %>
              <option <%= (s.status||'Active')===st?'selected':'' %>><%= st %></option>
            <% }); %>
          </select>
          <% if (s.pan) { %>
            <span class="badge <%= STATUS_BADGE[s.status]||'no' %>" style="margin-left:6px"><%= s.status %></span>
            <% if (s.pin_retries > 0) { %>
              <span class="badge warn" style="margin-left:4px">PIN retries: <%= s.pin_retries %></span>
            <% } %>
          <% } %>
        </div>
        <div style="display:flex; gap:12px">
          <div class="form-row" style="flex:1">
            <label>Account Type 1</label>
            <select class="med" name="account_type1">
              <% ['Savings','Checking','Credit','Money Market'].forEach(function(t){ %>
                <option <%= (s.account_type1||'Savings')===t?'selected':'' %>><%= t %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-row" style="flex:1">
            <label>Account Type 2</label>
            <select class="med" name="account_type2">
              <% ['Checking','Savings','Credit','Money Market','None'].forEach(function(t){ %>
                <option <%= (s.account_type2||'Checking')===t?'selected':'' %>><%= t %></option>
              <% }); %>
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="actions">
      <button class="btn primary" type="submit">Save Card</button>
      <a class="btn" href="/cards">New</a>
    </div>
  </div>
  </form>

  <!-- Positive Balance / Accounts -->
  <% if (s.pan) { %>
  <div class="mdi-body" style="border-top:1px solid #E0E0E0">
    <div class="tabstrip" style="margin-bottom:8px">
      <a href="#" class="active">Positive Balance / Accounts</a>
      <a href="#" class="disabled">Usages</a>
      <a href="#" class="disabled">Pre-authorization Holds</a>
    </div>
    <table class="grid">
      <tr><th>Account ID</th><th>Type</th><th>Status</th><th>Available</th><th>Ledger</th><th>Currency</th><th>Limit</th><th></th></tr>
      <% if (accounts.length === 0) { %>
        <tr><td colspan="8" style="color:#888">(no accounts configured)</td></tr>
      <% } %>
      <% accounts.forEach(function(a){ %>
        <tr>
          <td><b><%= a.account_id %></b></td>
          <td><%= a.account_type %></td>
          <td><span class="badge <%= a.status==='Active'?'ok':'no' %>"><%= a.status %></span></td>
          <td style="text-align:right"><b><%= Number(a.available_bal).toFixed(2) %></b></td>
          <td style="text-align:right"><%= Number(a.ledger_bal).toFixed(2) %></td>
          <td><%= a.currency_code %></td>
          <td><%= a.limit_profile||'—' %></td>
          <td>
            <form method="post" action="/cards/account/delete" onsubmit="return confirm('Delete account?')" style="display:inline">
              <input type="hidden" name="id" value="<%= a.id %>">
              <button class="btn danger" style="padding:1px 6px">✕</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </table>

    <!-- Add account form -->
    <details style="margin-top:10px">
      <summary class="btn" style="cursor:pointer; display:inline-block">＋ Add Account</summary>
      <form method="post" action="/cards/account" style="margin-top:8px; padding:10px; background:#f7f9fc; border:1px solid #ddd">
        <input type="hidden" name="card_pan" value="<%= s.pan %>">
        <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end">
          <div class="form-row" style="margin-bottom:0">
            <label>Account ID</label>
            <input class="med" type="text" name="account_id" placeholder="SV-1234" required>
          </div>
          <div class="form-row" style="margin-bottom:0">
            <label>Type</label>
            <select class="med" name="account_type">
              <% ['Savings','Checking','Credit','Money Market'].forEach(function(t){ %><option><%= t %></option><% }); %>
            </select>
          </div>
          <div class="form-row" style="margin-bottom:0">
            <label>Status</label>
            <select class="short" name="status"><option>Active</option><option>Blocked</option></select>
          </div>
          <div class="form-row" style="margin-bottom:0">
            <label>Available Bal</label>
            <input class="short" type="number" step="0.01" name="available_bal" value="0.00">
          </div>
          <div class="form-row" style="margin-bottom:0">
            <label>Ledger Bal</label>
            <input class="short" type="number" step="0.01" name="ledger_bal" value="0.00">
          </div>
          <div class="form-row" style="margin-bottom:0">
            <label>Currency</label>
            <select class="short" name="currency_code">
              <% ['USD','EUR','GBP','MXN','COP'].forEach(function(c){ %><option><%= c %></option><% }); %>
            </select>
          </div>
          <div class="form-row" style="margin-bottom:0">
            <label>Limit Profile</label>
            <select class="med" name="limit_profile">
              <% limits.forEach(function(l){ %><option><%= l %></option><% }); %>
            </select>
          </div>
          <button class="btn primary">Save Account</button>
        </div>
      </form>
    </details>
  </div>
  <% } %>

  <div class="mdi-status"><span class="ico">ℹ️</span>
    <% if (s.pan) { %>
      Card <%= s.pan.slice(0,6)+'****'+s.pan.slice(-4) %> — <%= s.cardholder_name||'N/A' %> | Issuer: <%= s.issuer_id||'N/A' %>
    <% } else { %>
      Customer Management — Card Configuration
    <% } %>
  </div>
</div>
<%- include('partials/bottom') %>
