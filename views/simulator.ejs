<%- include('partials/top') %>
<% const f = form || {}; %>
<%
const AC_CLASS = {
  '00':'ok', '05':'no', '14':'no', '41':'no', '43':'no',
  '51':'no', '54':'warn', '55':'no', '61':'no', '65':'no', '91':'no', '96':'no'
};
const AC_NAMES = {
  '00':'Approved','05':'Do Not Honor','14':'Invalid Card Number',
  '41':'Lost Card','43':'Stolen Card','51':'Insufficient Funds',
  '54':'Expired Card','55':'Incorrect PIN','61':'Exceeds Amount Limit',
  '65':'Exceeds Frequency Limit','91':'Switch Inoperative','96':'System Malfunction'
};
%>
<div class="mdi-window" style="max-width:900px">
  <div class="mdi-title"><span class="ico">▶️</span> Transaction Simulator — EPS Development ESNCService
    <span class="spacer"></span>
    <span class="mini-win">_</span><span class="mini-win">▢</span><span class="mini-win close">✕</span>
  </div>

  <div class="mdi-body">
    <!-- ── Transaction Request ────────────────────────────────────────────── -->
    <form method="post" action="/simulator" id="simForm">
      <fieldset class="group"><legend>Transaction Request — ISO 8583</legend>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px">
          <div>
            <div class="form-row">
              <label style="min-width:130px"><b>F2</b> PAN</label>
              <input class="long" type="text" name="pan" value="<%= f.pan||'' %>"
                     placeholder="16-digit card number">
            </div>
            <div class="form-row">
              <label style="min-width:130px"><b>F4</b> Amount</label>
              <input class="short" type="text" name="amount" value="<%= f.amount||'' %>">
              &nbsp;USD
            </div>
            <div class="form-row">
              <label style="min-width:130px"><b>F3</b> Processing Code</label>
              <select class="med" name="txn_type">
                <% [
                  {v:'Withdrawal',     c:'01 — Withdrawal (Cash)'},
                  {v:'Purchase',       c:'00 — Purchase'},
                  {v:'Balance Inquiry',c:'31 — Balance Inquiry'},
                  {v:'Transfer',       c:'40 — Transfer'},
                  {v:'Reversal',       c:'20 — Reversal'},
                ].forEach(function(t){ %>
                  <option value="<%= t.v %>" <%= f.txn_type===t.v?'selected':'' %>><%= t.c %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div>
            <div class="form-row">
              <label style="min-width:130px"><b>F41</b> Terminal ID / Source</label>
              <select class="med" name="source">
                <% [{v:'ATM',l:'ATM — 6011xxxx'},{v:'POS',l:'POS — Merchant terminal'},{v:'Interchange',l:'Interchange — ISO link'}].forEach(function(t){ %>
                  <option value="<%= t.v %>" <%= f.source===t.v?'selected':'' %>><%= t.l %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-row">
              <label style="min-width:130px"><b>F52</b> PIN Block</label>
              <label style="min-width:0; cursor:pointer">
                <input type="checkbox" name="wrong_pin" value="1" <%= f.wrong_pin==='1'?'checked':'' %>>
                Simulate wrong PIN (triggers AC-55 / card block)
              </label>
            </div>
            <div style="margin-top:6px">
              <div class="hint" style="font-size:10px; margin-bottom:6px">
                Active prefixes:
                <% prefixes.forEach(function(p){ %>
                  <span class="pill" style="font-size:10px"><%= p.prefix %> · <%= p.prefix_type %></span>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
        <div class="actions" style="margin-top:8px">
          <button class="btn primary" type="submit">&#9654; Authorize</button>
          <a class="btn" href="/simulator">Reset</a>
          <a class="btn" href="/cards" style="margin-left:8px">&#128179; Manage Cards</a>
        </div>
      </fieldset>
    </form>

    <% if (result) { %>
    <!-- ── Authorization Response ─────────────────────────────────────────── -->
    <fieldset class="group"><legend>Authorization Response — STAN <%= result.stan %></legend>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px">
        <div>
          <table class="grid" style="font-size:11px">
            <tr><th style="width:140px">Field</th><th>Value</th></tr>
            <tr><td><b>F39</b> Action Code</td>
                <td><span class="badge <%= AC_CLASS[result.action_code]||'no' %>">
                  <%= result.action_code %> — <%= result.action_desc %>
                </span></td></tr>
            <tr><td><b>F11</b> STAN</td><td><code><%= result.stan %></code></td></tr>
            <tr><td><b>F2</b> PAN (masked)</td><td><code><%= result.pan %></code></td></tr>
            <tr><td><b>F4</b> Amount</td><td><b><%= result.amount ? Number(result.amount).toFixed(2) : '—' %></b> USD</td></tr>
            <tr><td>Txn Type</td><td><%= result.txn_type %> | <%= result.source %></td></tr>
            <tr><td>On-Us / Not-On-Us</td>
                <td><span class="badge <%= result.on_us?'ok':'warn' %>"><%= result.on_us?'On-Us':'Not-On-Us' %></span></td></tr>
          </table>
        </div>
        <div>
          <table class="grid" style="font-size:11px">
            <tr><th style="width:140px">Field</th><th>Value</th></tr>
            <tr><td>Prefix Matched</td><td><code><%= result.prefix_matched||'—' %></code></td></tr>
            <tr><td>Issuer ID</td><td><b><%= result.issuer_id||'—' %></b></td></tr>
            <% if (result.card_status) { %>
            <tr><td>Card Status</td><td><span class="badge <%= {Active:'ok',Blocked:'no',Lost:'warn',Stolen:'no',Expired:'warn'}[result.card_status]||'no' %>"><%= result.card_status %></span></td></tr>
            <% } %>
            <tr><td>Limit Profile</td><td><%= result.limit_profile||'—' %></td></tr>
            <tr><td>Limit Result</td><td><%= result.limit_result||'—' %></td></tr>
            <tr><td>Routed To</td><td><b><%= result.routed_to||'—' %></b></td></tr>
          </table>
        </div>
      </div>
      <!-- Trace log -->
      <div style="margin-top:8px">
        <div style="font-size:10px; font-weight:bold; color:#555; margin-bottom:4px">Authorization Trace (Steps):</div>
        <div class="trace"><% result.steps.forEach(function(st){ %><%= st %>&#10;<% }); %></div>
      </div>
    </fieldset>
    <% } %>

    <!-- ── Journal ───────────────────────────────────────────────────────── -->
    <fieldset class="group"><legend>Journal — Last 50 Transactions</legend>
      <table class="grid" style="font-size:10px">
        <tr>
          <th>STAN</th><th>PAN</th><th>Amount</th><th>Type</th><th>Src</th>
          <th>Prefix</th><th>Issuer</th><th>On-Us</th><th>Card</th>
          <th>Limit</th><th>Routed To</th><th>AC</th><th>Time</th>
        </tr>
        <% if (journal.length===0) { %>
          <tr><td colspan="13" style="color:#888; text-align:center">(journal empty)</td></tr>
        <% } %>
        <% journal.forEach(function(j){ %>
          <tr>
            <td><code><%= j.stan %></code></td>
            <td><code><%= j.pan %></code></td>
            <td style="text-align:right"><%= Number(j.amount).toFixed(2) %></td>
            <td><%= j.txn_type %></td>
            <td><%= j.source %></td>
            <td><code><%= j.prefix_matched||'—' %></code></td>
            <td><b><%= j.issuer_id||'—' %></b></td>
            <td><span class="badge <%= j.on_us?'ok':'warn' %>" style="padding:0 4px; font-size:9px"><%= j.on_us?'Y':'N' %></span></td>
            <td><%= j.card_status||'—' %></td>
            <td><%= j.limit_profile||'—' %></td>
            <td><%= j.routed_to||'—' %></td>
            <td><span class="badge <%= AC_CLASS[j.action_code]||'no' %>" style="padding:0 5px; font-size:10px"><%= j.action_code %></span></td>
            <td style="white-space:nowrap"><%= j.created_at ? String(j.created_at).slice(0,19) : '' %></td>
          </tr>
        <% }); %>
      </table>
      <div class="actions" style="margin-top:6px">
        <form method="post" action="/simulator/clear" onsubmit="return confirm('Clear all journal entries?')">
          <button class="btn danger">Clear Journal</button>
        </form>
        <span class="hint" style="margin-left:10px">Action codes: 00=Approved · 05=DoNotHonor · 14=InvalidPAN · 41=Lost · 43=Stolen · 51=InsufficientFunds · 54=Expired · 55=WrongPIN · 61=AmtLimit · 65=CntLimit · 91=Inoperative</span>
      </div>
    </fieldset>
  </div>
  <div class="mdi-status"><span class="ico">ℹ️</span> System Operations — Transaction Simulator &mdash; ESNCService</div>
</div>
<%- include('partials/bottom') %>
